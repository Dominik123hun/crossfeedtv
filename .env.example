# ─────────────────────────────────────────────────────────────────────────────
# CrossFeed.tv configuration
# Copy to ".env" (Node >= 20.6 loads it automatically) and edit.
# Every value here is OPTIONAL — the overlay can also pass channels via query
# params (overlay.html?twitch=xqc&kick=xqc&x=<broadcastId>). Env vars set the
# DEFAULT channels the backend connects to on startup.
# ─────────────────────────────────────────────────────────────────────────────

# --- HTTP / WebSocket server ---
HOST=0.0.0.0
PORT=8080
# Override the directory the static overlay is served from (defaults to ./public)
# PUBLIC_DIR=

# --- Default channels to ingest on startup (optional) ---
# Twitch channel login name (no leading #), e.g. "xqc"
TWITCH_CHANNEL=
# Kick channel slug, e.g. "xqc"
KICK_CHANNEL=
# X / Twitter broadcast id (the long id in a live broadcast URL)
X_BROADCAST_ID=

# --- Twitch ---
# Anonymous Twitch IRC-over-WebSocket endpoint. Rarely needs changing.
TWITCH_WS_URL=wss://irc-ws.chat.twitch.tv:443
# Multiplex many channels onto a few shared IRC connections (scales to lots of
# distinct channels on one host). Set false for one connection per channel.
TWITCH_MULTIPLEX=true
# Channels JOINed per shared connection before opening another.
TWITCH_MAX_CHANNELS_PER_CONN=50
# JOIN rate limit per connection (Twitch allows ~20 / 10s; stay under it).
TWITCH_JOINS_PER_WINDOW=18
TWITCH_JOIN_WINDOW_MS=10000

# --- Kick ---
# By default Kick tries the @retconned/kick-js library (optional install), then
# falls back to a built-in Pusher-WebSocket adapter. Set this to skip the
# library and go straight to the Pusher adapter (lighter; no Chromium).
KICK_FORCE_PUSHER=false
# Base URL for the Cloudflare-protected channel lookup. Override to use a proxy.
KICK_API_BASE=https://kick.com
# Pusher app key/cluster for Kick chat. These are observed-from-browser values
# that can change — see RECON.md for how to capture the current ones.
KICK_PUSHER_APP_KEY=32cbd69e4b950bf97679
KICK_PUSHER_CLUSTER=us2
KICK_PUSHER_VERSION=8.4.0
# How long to wait for kick-js to connect before falling back to Pusher (ms).
KICK_READY_TIMEOUT_MS=20000

# --- Kick OFFICIAL API adapter (OAuth 2.1 + webhooks) — OFF by default ---
# Groundwork only. The default Kick ingester above keeps working; this is a
# separate, additive path. Leave disabled unless you've registered a Kick app
# and have a public https webhook URL. See RECON.md + OVERNIGHT_LOG.md.
KICK_OFFICIAL_ENABLED=false
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Local path Kick POSTs events to; map your public https URL to this path.
KICK_WEBHOOK_PATH=/webhooks/kick
KICK_WEBHOOK_PUBLIC_URL=
# Kick's event-signing RSA public key (PEM). Use \n for newlines when inline.
KICK_EVENT_PUBLIC_KEY=

# --- X (Twitter) broadcasts --- EXPERIMENTAL / BETA, unofficial ---
# There is NO official API for X broadcast chat; this replicates the public
# pscp.tv (Periscope) handshake the web player uses. It is BETA and may break.
#
# BETA FLAG: X is OFF unless this is true. The dashboard/overlay label it beta.
X_ENABLED=false
#
# By default ("auto" → periscope) it auto-resolves any broadcast id — no creds:
#   guest token (api.x.com/1.1/guest/activate.json) → broadcasts/show.json →
#   chat_token → accessChatPublic → wss …/chatapi/v1/chatnow.
# Verify one broadcast without enabling X:  npm run x:probe -- <id|url>
#
# Override hosts only if X/pscp.tv change them:
X_API_BASE=
X_PSCP_BASE=
# Override the public web bearer if guest auth starts returning 401 (see RECON.md):
X_BEARER=
# Optional: supply a pre-minted guest token (skips activate.json):
X_GUEST_TOKEN=
#
# X_MODE: auto | periscope | static | http | browser  (auto → periscope)
X_MODE=auto
#
#   static — paste values captured straight from DevTools (one broadcast):
X_CHAT_WS_URL=
X_ACCESS_TOKEN=
#   http   — replicate the access XHR ({broadcastId} is substituted):
X_ACCESS_URL=
X_AUTH_BEARER=
#   browser — Puppeteer token-minter (SCALES to 20+): one logged-in session
#             mints tokens for many broadcasts. Needs `npm i puppeteer` and a
#             logged-in session via these captured cookies:
X_AUTH_TOKEN=
X_CSRF=
X_BROWSER_HEADLESS=true
#
# Optional: override the (TODO) subscribe frame; substitutes {token}/{broadcastId}.
X_SUBSCRIBE_FRAME=
# Re-mint a token after this many ms (tokens are short-lived).
X_TOKEN_TTL_MS=240000

# --- Reconnect backoff (shared by every ingester) ---
RECONNECT_INITIAL_MS=1000
RECONNECT_MAX_MS=30000
RECONNECT_FACTOR=2
# Jitter as a fraction of the computed delay (0.3 = +/-30%)
RECONNECT_JITTER=0.3
# Force a reconnect if a connect doesn't finish its handshake within this long.
RECONNECT_CONNECT_TIMEOUT_MS=15000

# --- Logging ---
# error | warn | info | debug
LOG_LEVEL=info

# --- Multi-tenant SaaS (accounts + dashboard) ---
# Where the user/session store is written (a JSON file; swap for a real DB at scale).
# Mount a persistent volume/disk at this path in production so accounts survive
# redeploys. On Railway you can leave this blank: if a Volume is attached we use
# its mount path automatically (RAILWAY_VOLUME_MOUNT_PATH). Precedence:
# DATA_DIR > RAILWAY_VOLUME_MOUNT_PATH > ./data
DATA_DIR=./data
# Data store backend: "json" (default, dependency-free file) or "sqlite".
# sqlite uses Node's built-in node:sqlite (no native build, works on Alpine) and
# gives row-level writes + WAL durability — better once you have more than a few
# users. On first run with STORE_DRIVER=sqlite an existing crossfeed-db.json is
# imported automatically (the JSON file is left untouched).
STORE_DRIVER=json
# Session lifetime in ms (default 30 days).
SESSION_TTL_MS=2592000000
# Per-IP rate limit for signup/login (attempts per window).
AUTH_RATE_MAX=20
AUTH_RATE_WINDOW_MS=300000
# Secure cookie flag. Leave unset to auto-detect from x-forwarded-proto (https).
# Set false for plain-http local dev if your browser drops the cookie.
# COOKIE_SECURE=true

# --- Email (verification + password reset) ---
# Require a verified email before login is allowed. Default ON. Existing accounts
# are grandfathered as verified, so turning this on never locks out current users.
REQUIRE_EMAIL_VERIFICATION=true
# Transactional email provider. With RESEND_API_KEY set, emails go via the Resend
# HTTP API; without it, links are printed to the server log (fine for local dev).
# RESEND_API_KEY=re_xxxxxxxx
# From address (must be on a domain you've verified in Resend).
# EMAIL_FROM=Crossfeed <noreply@yourdomain.com>
# Public base URL used to build links in emails. If unset, it's derived from the
# request host — set it explicitly in production (e.g. https://crossfeed.tv).
# APP_BASE_URL=https://your-app.example.com
